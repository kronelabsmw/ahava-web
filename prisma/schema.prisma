generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  STAFF_ADMIN
}

enum DressListingType {
  HIRE
  SALE
  HIRE_AND_SALE
}

enum InquiryStatus {
  PENDING
  CONTACTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  PICKED_UP
  RETURNED
  COMPLETED
  OVERDUE
  CANCELLED
}

enum CustomOrderStatus {
  INQUIRY
  QUOTED
  DEPOSIT_PAID
  DESIGN_APPROVED
  IN_PRODUCTION
  FINAL_APPROVAL
  SHIPPED
  DELIVERED
}

enum SaleType {
  DRESS_HIRE
  DRESS_PURCHASE
  CUSTOM_ORDER
  EVENT_PACKAGE
  FITTING
  OTHER
}

enum SaleChannel {
  SYSTEM
  OFFLINE
}

enum SalePaymentStatus {
  QUOTED
  DEPOSIT_RECEIVED
  PARTIALLY_PAID
  PAID
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CASH
  WHATSAPP
  BANK_TRANSFER
  MOBILE_MONEY
  CARD
  OTHER
}

enum EventBookingStatus {
  INQUIRY
  QUOTED
  DEPOSIT_PAID
  CONFIRMED
  COMPLETED
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(STAFF_ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  description    String           @db.Text
  price          Decimal          @db.Decimal(10, 2)
  discountPrice  Decimal?         @db.Decimal(10, 2)
  salePrice      Decimal?         @db.Decimal(10, 2)
  listingType    DressListingType @default(HIRE)
  condition      String?
  depositPercent Int?             @default(45)
  specialNotes   String?          @db.Text
  stock          Int              @default(0)
  featured       Boolean          @default(false)
  active         Boolean          @default(true)
  tags           String[]
  videoUrl       String?
  categoryId     String
  category       Category         @relation(fields: [categoryId], references: [id])
  brandId        String?
  brand          Brand?           @relation(fields: [brandId], references: [id])
  images         ProductImage[]
  variants       ProductVariant[]
  inquiries      Inquiry[]
  bookings       DressBooking[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String?
  order     Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id        String  @id @default(cuid())
  size      String
  color     String
  stock     Int     @default(0)
  sku       String?
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Promotion {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String    @db.Text
  image       String?
  discount    Int?
  active      Boolean   @default(true)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Inquiry {
  id            String        @id @default(cuid())
  customerName  String
  customerPhone String
  customerEmail String?
  message       String?       @db.Text
  status        InquiryStatus @default(PENDING)
  productId       String?
  product         Product?      @relation(fields: [productId], references: [id])
  eventPackageId  String?
  eventPackage    EventPackage? @relation(fields: [eventPackageId], references: [id])
  variantInfo     String?
  weddingDate   DateTime?
  eventLocation String?
  ukSize        String?
  totalAmount   Decimal?      @db.Decimal(10, 2)
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  booking       DressBooking?
  saleRecords   SaleRecord[]
  eventBooking  EventPackageBooking?
}

model DressBooking {
  id              String        @id @default(cuid())
  inquiryId       String?       @unique
  inquiry         Inquiry?      @relation(fields: [inquiryId], references: [id])
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  variantInfo     String?
  customerName    String
  customerPhone   String
  customerEmail   String?
  weddingDate     DateTime
  eventLocation   String
  ukSize          String?
  bookingDeposit  Decimal       @db.Decimal(10, 2)
  securityDeposit Decimal       @default(50000) @db.Decimal(10, 2)
  balanceDue      Decimal       @db.Decimal(10, 2)
  pickupDate      DateTime
  returnDeadline  DateTime
  status          BookingStatus @default(PENDING)
  lateFeePerDay   Decimal       @default(20000) @db.Decimal(10, 2)
  lateFeesAccrued Decimal       @default(0) @db.Decimal(10, 2)
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  saleRecord      SaleRecord?
}

model EventPackage {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  description       String   @db.Text
  price             Decimal  @db.Decimal(10, 2)
  servicesIncluded  String[]
  guestCount        Int?
  additionalCharges String?  @db.Text
  image             String?
  active            Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  inquiries         Inquiry[]
  bookings          EventPackageBooking[]
}

model CustomOrder {
  id               String            @id @default(cuid())
  customerName     String
  customerPhone    String
  customerEmail    String?
  eventDate        DateTime?
  status           CustomOrderStatus @default(INQUIRY)
  inspirationNotes String?           @db.Text
  quoteAmount      Decimal?          @db.Decimal(10, 2)
  depositPaid      Decimal?          @db.Decimal(10, 2)
  measurements     String?           @db.Text
  timelineNotes    String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  saleRecord       SaleRecord?
}

model EventPackageBooking {
  id             String              @id @default(cuid())
  eventPackageId String
  eventPackage   EventPackage        @relation(fields: [eventPackageId], references: [id])
  inquiryId      String?             @unique
  inquiry        Inquiry?            @relation(fields: [inquiryId], references: [id])
  customerName   String
  customerPhone  String
  customerEmail  String?
  eventDate      DateTime?
  eventLocation  String?
  guestCount     Int?
  quotedAmount   Decimal             @db.Decimal(10, 2)
  depositPaid    Decimal             @default(0) @db.Decimal(10, 2)
  status         EventBookingStatus  @default(INQUIRY)
  notes          String?             @db.Text
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  saleRecord     SaleRecord?
}

model InventoryLog {
  id        String   @id @default(cuid())
  productId String
  change    Int
  reason    String
  notes     String?
  createdAt DateTime @default(now())
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SaleRecord {
  id            String            @id @default(cuid())
  type          SaleType
  channel       SaleChannel       @default(SYSTEM)
  title         String
  customerName  String?
  customerPhone String?
  totalAmount   Decimal           @db.Decimal(10, 2)
  paidAmount    Decimal           @default(0) @db.Decimal(10, 2)
  lateFees      Decimal           @default(0) @db.Decimal(10, 2)
  status        SalePaymentStatus @default(QUOTED)
  saleDate      DateTime          @default(now())
  notes         String?           @db.Text
  bookingId     String?           @unique
  booking       DressBooking?     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customOrderId String?           @unique
  customOrder   CustomOrder?      @relation(fields: [customOrderId], references: [id], onDelete: Cascade)
  inquiryId             String?
  inquiry               Inquiry?             @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  eventPackageBookingId String?              @unique
  eventPackageBooking   EventPackageBooking? @relation(fields: [eventPackageBookingId], references: [id], onDelete: Cascade)
  payments              PaymentEntry[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([saleDate])
  @@index([type])
  @@index([channel])
  @@index([status])
}

model PaymentEntry {
  id           String        @id @default(cuid())
  saleRecordId String
  saleRecord   SaleRecord    @relation(fields: [saleRecordId], references: [id], onDelete: Cascade)
  amount       Decimal       @db.Decimal(10, 2)
  method       PaymentMethod @default(CASH)
  reference    String?
  paidAt       DateTime      @default(now())
  notes        String?
  createdAt    DateTime      @default(now())

  @@index([saleRecordId])
  @@index([paidAt])
}
